{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "mi-sample"
  },
  "WorkerTiming": {
    "LeaseTtlSeconds": 15,
    "LeaseRenewIntervalMs": 2000,
    "InstanceHeartbeatTtlSeconds": 15,
    "InstanceHeartbeatIntervalMs": 2000,
    "DrainTimeoutSeconds": 10,
    "JobStatsTtlSeconds": 30
  }
}
