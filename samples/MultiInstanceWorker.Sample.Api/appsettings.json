{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "mi-sample"
  },
  "WorkerTiming": {
    "LeaseTtlMs": 15000,
    "LeaseRenewIntervalMs": 2000,
    "InstanceHeartbeatTtlMs": 15000,
    "InstanceHeartbeatIntervalMs": 2000,
    "DrainTimeoutMs": 10000,
    "JobStatsTtlSeconds": 30
  }
}
